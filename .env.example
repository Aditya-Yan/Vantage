# Environment variable template.
#
# Variable NAMES only. Never commit values to this file.
# Copy to .env and fill in locally. .env is gitignored and must stay that way.
#
# Every model name is a variable, never a literal in code (MASTER_PLAN 3).

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
APP_ENV=
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server and worker only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations and worker integration tests.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Sanctioned purposes only: ambiguous role classification, recruiter research
# reasoning, email draft generation, and offline company scoring.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=

# One model per purpose so cost and capability can be tuned independently.
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_EMAIL_DRAFT=
LLM_MODEL_COMPANY_SCORING=

# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Search provider
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# ---------------------------------------------------------------------------
# Notification provider
# ---------------------------------------------------------------------------
# Console in development, email in production.
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_TO_ADDRESS=

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# GitHub API token for community tracker repositories (public read).
GITHUB_TOKEN=

# Reddit official API credentials. Secondary signal source, feature-flagged.
# Without these the live adapter stays disabled and is tested via fixtures.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_REDDIT_SOURCE=
ENABLE_LINKEDIN_PUBLIC_ENRICHMENT=
ENABLE_LLM_CLASSIFICATION_FALLBACK=

# ---------------------------------------------------------------------------
# Thresholds and tuning
# ---------------------------------------------------------------------------
# Configurable rather than scattered as constants (MASTER_PLAN 0.18).
COMPANY_TARGET_SCORE_THRESHOLD=
CLASSIFICATION_ACCEPT_THRESHOLD=
CLASSIFICATION_REJECT_THRESHOLD=
FEED_VISIBILITY_DAYS=
RAW_PAYLOAD_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# NOT configured here
# ---------------------------------------------------------------------------
# LinkedIn credentials are intentionally absent and must never be added.
# LinkedIn is anonymous public-information enrichment only: no authentication,
# no session cookies, no account automation. Permanently out of scope.
